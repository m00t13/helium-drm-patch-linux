from typing import Any

WIDEVINE_APP_ID = "oimompecagnajdejgnnjijobebaeigek"
OMAHA_URL = "https://update.googleapis.com/service/update2/json"
CHROME_DEB_URL = (
    "https://dl.google.com/linux/direct/google-chrome-stable_current_amd64.deb"
)
DEFAULT_PROD_VERSION = "158.0.8127.88"
USER_AGENT = "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/158.0.0.0 Safari/537.36"

PROBE_HTML = """<!doctype html>
<html>
<head><meta charset="utf-8"><title>CHECKING</title></head>
<body>
<pre id="eme-result"></pre>
<script>
(async () => {
  const probes = {
    vp9: [{ initDataTypes: ["cenc"], videoCapabilities: [{ contentType: 'video/webm; codecs="vp9"' }] }],
    h264: [{ initDataTypes: ["cenc"], videoCapabilities: [{ contentType: 'video/mp4; codecs="avc1.42E01E"' }] }],
    aac: [{ initDataTypes: ["cenc"], audioCapabilities: [{ contentType: 'audio/mp4; codecs="mp4a.40.2"' }] }],
  };
  const results = {};
  for (const [name, config] of Object.entries(probes)) {
    try {
      const access = await navigator.requestMediaKeySystemAccess("com.widevine.alpha", config);
      results[name] = { ok: true, keySystem: access.keySystem, configuration: access.getConfiguration() };
    } catch (err) {
      results[name] = { ok: false, error: err && err.name ? `${err.name}: ${err.message}` : String(err) };
    }
  }
  document.getElementById("eme-result").textContent = JSON.stringify(results);
  document.title = "DONE";
})();
</script>
</body>
</html>
"""


@dataclass(frozen=True)
class ArchConfig:
    omaha_arch: str
    nacl_arch: str
    os_arch: str
    subpkg: str
    deb_supported: bool


def detect_arch() -> ArchConfig:
    """Map host CPU architecture to Omaha and Widevine subpackage identifiers."""
    machine = platform.machine().lower()
    if machine in ("x86_64", "amd64"):
        return ArchConfig(
            omaha_arch="x64",
            nacl_arch="x86-64",
            os_arch="x86_64",
            subpkg="linux_x64",
            deb_supported=True,
        )
    if machine in ("aarch64", "arm64"):
        return ArchConfig(
            omaha_arch="arm64",
            nacl_arch="arm",
            os_arch="arm64",
            subpkg="linux_arm64",
            deb_supported=False,
        )
    raise RuntimeError(f"Unsupported architecture for Widevine CDM: {machine}")


def default_user_data_dir() -> Path:
    """Return Helium's default XDG user data directory."""
    xdg_config = os.environ.get("XDG_CONFIG_HOME")
    base = Path(xdg_config) if xdg_config else Path.home() / ".config"
    return base / "net.imput.helium"


def find_helium_binary(explicit: Path | None = None) -> Path:
    """Locate the Helium browser executable on the system."""
    if explicit is not None:
        expanded = explicit.expanduser()
        if expanded.is_file():
            return expanded
        found = shutil.which(str(explicit))
        if found:
            return Path(found)
        raise RuntimeError(f"Specified Helium binary not found: {explicit}")

    candidates: list[str | Path] = [
        shutil.which("helium-browser") or "",
        shutil.which("helium") or "",
        Path("/usr/bin/helium-browser"),
        Path("/opt/helium-browser-bin/helium-wrapper"),
        Path("/usr/local/bin/helium"),
        Path.home() / ".local" / "bin" / "helium",
    ]
    for candidate in candidates:
        if not candidate:
            continue
        p = Path(candidate)
        if p.is_file():
            return p
    raise RuntimeError(
        "Could not locate Helium binary; pass --helium-binary /path/to/helium"
    )


def detect_prod_version(user_data_dir: Path) -> str:
    """Extract the Chromium numeric version from Helium's Local State JSON."""
    local_state = user_data_dir / "Local State"
    if not local_state.is_file():
        return DEFAULT_PROD_VERSION
    try:
        data = json.loads(local_state.read_text(encoding="utf-8"))
        raw = (
            data.get("user_experience_metrics", {})
            .get("stability", {})
            .get("stats_version", "")
        )
        match = re.match(r"^(\d+(?:\.\d+){1,3})", str(raw).strip())
        if match:
            return match.group(1)
    except (OSError, ValueError, TypeError):
        pass
    return DEFAULT_PROD_VERSION


def strip_xssi_prefix(raw_text: str) -> str:
    """Strip Google's XSSI protection prefix (e.g. )]}'\\n) from JSON responses."""
    if raw_text.startswith(")]}'"):
        newline_idx = raw_text.find("\n")
        if newline_idx != -1:
            return raw_text[newline_idx + 1 :]
        return raw_text[4:]
    return raw_text


def http_request(
    url: str,
    *,
    data: bytes | None = None,
    headers: dict[str, str] | None = None,
    timeout: int = 60,
) -> bytes:
    """Perform an HTTP GET or POST request and return raw response bytes."""
    req_headers = {"User-Agent": USER_AGENT}
    if headers:
        req_headers.update(headers)
    req = urllib.request.Request(url, data=data, headers=req_headers)
    with urllib.request.urlopen(req, timeout=timeout) as resp:
        return resp.read()


def safe_extract_zip(zip_bytes: bytes, dest_dir: Path) -> None:
    """Extract a ZIP archive into dest_dir while rejecting path traversal."""
    dest_resolved = dest_dir.resolve()
    with zipfile.ZipFile(io.BytesIO(zip_bytes)) as zf:
        for member in zf.infolist():
            member_path = Path(member.filename)
            if member_path.is_absolute() or ".." in member_path.parts:
                raise ValueError(f"Unsafe ZIP member path: {member.filename}")
            target = (dest_resolved / member_path).resolve()
            if target != dest_resolved and dest_resolved not in target.parents:
                raise ValueError(f"ZIP member escapes target directory: {member.filename}")
            if member.is_dir():
                target.mkdir(parents=True, exist_ok=True)
            else:
                target.parent.mkdir(parents=True, exist_ok=True)
                with zf.open(member, "r") as src, open(target, "wb") as dst:
                    shutil.copyfileobj(src, dst)


def extract_crx3(crx_bytes: bytes, dest_dir: Path) -> None:
    """Parse CRX3 header and extract embedded ZIP payload."""
    if len(crx_bytes) < 12 or crx_bytes[:4] != b"Cr24":
        raise ValueError("Invalid CRX3 magic header (expected Cr24)")
    crx_version, header_len = struct.unpack("<II", crx_bytes[4:12])
    if crx_version != 3:
        raise ValueError(f"Unsupported CRX version: {crx_version}")
    zip_offset = 12 + header_len
    if zip_offset >= len(crx_bytes):
        raise ValueError("CRX3 header length exceeds payload size")
    zip_bytes = crx_bytes[zip_offset:]
    if zip_bytes[:4] != b"PK\x03\x04":
        raise ValueError("CRX3 payload does not start with ZIP local file header")
    safe_extract_zip(zip_bytes, dest_dir)


def fetch_via_omaha(prod_version: str, staging_dir: Path, arch: ArchConfig) -> str:
    """Fetch Widevine CDM CRX3 via Google Omaha component update API."""
    payload = {
        "request": {
            "@os": "linux",
            "@updater": "chromiumcrx",
            "acceptformat": "crx3",
            "app": [
                {
                    "appid": WIDEVINE_APP_ID,
                    "brand": "",
                    "enabled": True,
                    "updatecheck": {},
                    "version": "0.0.0.0",
                }
            ],
            "arch": arch.omaha_arch,
            "dedup": "cr",
            "nacl_arch": arch.nacl_arch,
            "os": {
                "arch": arch.os_arch,
                "platform": "Linux",
            },
            "prodversion": prod_version,
            "protocol": "3.1",
            "updaterversion": prod_version,
        }
    }
    raw_resp = http_request(
        OMAHA_URL,
        data=json.dumps(payload).encode("utf-8"),
        headers={"Content-Type": "application/json"},
        timeout=30,
    ).decode("utf-8")
    parsed = json.loads(strip_xssi_prefix(raw_resp))
    root = parsed.get("response", parsed)
    apps = root.get("app") or []
    if not apps:
        raise RuntimeError("Omaha response contained no app entries")
    updatecheck = apps[0].get("updatecheck") or {}
    status = updatecheck.get("status")
    if status != "ok":
        raise RuntimeError(f"Omaha updatecheck status was {status!r}")

    manifest = updatecheck.get("manifest") or {}
    version = str(manifest.get("version") or "").strip()
    packages = (manifest.get("packages") or {}).get("package") or []
    urls = (updatecheck.get("urls") or {}).get("url") or []
    if not version or not packages or not urls:
        raise RuntimeError("Omaha manifest missing version, packages, or download URLs")

    pkg = packages[0]
    pkg_name = pkg.get("name")
    expected_sha256 = str(pkg.get("hash_sha256") or "").lower()
    if not pkg_name:
        raise RuntimeError("Omaha package entry missing filename")

    last_err: Exception | None = None
    crx_bytes: bytes | None = None
    for url_entry in urls:
        codebase = str(url_entry.get("codebase") or "")
        if not codebase:
            continue
        download_url = f"{codebase.rstrip('/')}/{pkg_name.lstrip('/')}"
        try:
            print(f"Downloading Widevine CDM {version} ({arch.subpkg}) from {download_url} ...")
            candidate = http_request(download_url, timeout=120)
            actual_sha256 = hashlib.sha256(candidate).hexdigest().lower()
            if expected_sha256 and actual_sha256 != expected_sha256:
                raise ValueError(
                    f"SHA-256 mismatch: expected {expected_sha256}, got {actual_sha256}"
                )
            crx_bytes = candidate
            print(f"Verified SHA-256: {actual_sha256}")
            break
        except (OSError, urllib.error.URLError, ValueError) as exc:
            last_err = exc

    if crx_bytes is None:
        raise RuntimeError(f"Failed to download Widevine CRX3: {last_err}")

    extract_crx3(crx_bytes, staging_dir)
    return version


def fetch_via_chrome_deb(staging_dir: Path, arch: ArchConfig) -> str:
    """Fallback: download official Google Chrome .deb (amd64) and extract WidevineCdm."""
    if not arch.deb_supported:
        raise RuntimeError(
            f"Chrome .deb fallback is amd64-only and not available on {arch.subpkg}"
        )
    if not shutil.which("bsdtar"):
        raise RuntimeError("bsdtar is required for the Chrome .deb fallback")
    with tempfile.TemporaryDirectory(prefix="helium-chrome-deb-") as tmp:
        tmp_path = Path(tmp)
        deb_path = tmp_path / "google-chrome-stable_current_amd64.deb"
        print(f"Fallback: downloading {CHROME_DEB_URL} ...")
        deb_bytes = http_request(CHROME_DEB_URL, timeout=180)
        deb_path.write_bytes(deb_bytes)

        subprocess.run(
            ["bsdtar", "-xf", str(deb_path)],
            cwd=tmp_path,
            check=True,
        )
        data_archives = sorted(tmp_path.glob("data.tar*"))
        if not data_archives:
            raise RuntimeError("No data.tar.* archive found inside Chrome .deb")

        subprocess.run(
            [
                "bsdtar",
                "-xf",
                str(data_archives[0]),
                "opt/google/chrome/WidevineCdm",
            ],
            cwd=tmp_path,
            check=True,
        )
        extracted_cdm = tmp_path / "opt" / "google" / "chrome" / "WidevineCdm"
        if not extracted_cdm.is_dir():
            raise RuntimeError("opt/google/chrome/WidevineCdm missing from .deb payload")
        for item in extracted_cdm.iterdir():
            dst = staging_dir / item.name
            if item.is_dir():
                shutil.copytree(item, dst, dirs_exist_ok=True)
            else:
                shutil.copy2(item, dst)
    version, _ = validate_cdm_dir(staging_dir, arch.subpkg)
    return version


def resolve_local_widevine_dir(source_dir: Path) -> Path:
    """Resolve a user-supplied WidevineCdm path to the directory holding manifest.json."""
    if (source_dir / "manifest.json").is_file():
        return source_dir
    hint = source_dir / "latest-component-updated-widevine-cdm"
    if hint.is_file():
        data = json.loads(hint.read_text(encoding="utf-8"))
        hinted = Path(data["Path"])
        if (hinted / "manifest.json").is_file():
            return hinted
    version_dirs = sorted(
        (p for p in source_dir.iterdir() if p.is_dir() and (p / "manifest.json").is_file()),
        reverse=True,
    )
    if version_dirs:
        return version_dirs[0]
    raise FileNotFoundError(f"No Widevine manifest.json found under {source_dir}")


def validate_cdm_dir(cdm_dir: Path, subpkg: str) -> tuple[str, Path]:
    """Validate manifest.json and ELF libwidevinecdm.so in cdm_dir."""
    manifest_path = cdm_dir / "manifest.json"
    if not manifest_path.is_file():
        raise RuntimeError(f"Missing manifest.json in {cdm_dir}")
    manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
    version = str(manifest.get("version") or "").strip()
    if not version:
        raise RuntimeError(f"manifest.json in {cdm_dir} has empty version")

    so_path = cdm_dir / "_platform_specific" / subpkg / "libwidevinecdm.so"
    if not so_path.is_file() or so_path.stat().st_size == 0:
        raise RuntimeError(f"Missing or empty Widevine shared library at {so_path}")
    with open(so_path, "rb") as f:
        magic = f.read(4)
    if magic != b"\x7fELF":
        raise RuntimeError(f"{so_path} is not a valid ELF binary (header={magic!r})")
    return version, so_path


def set_cdm_permissions(root_dir: Path) -> None:
    """Normalize directory (0755), shared library (0755), and file (0644) modes."""
    os.chmod(root_dir, 0o755)
    for dirpath, dirnames, filenames in os.walk(root_dir):
        dp = Path(dirpath)
        os.chmod(dp, 0o755)
        for d in dirnames:
            os.chmod(dp / d, 0o755)
        for fn in filenames:
            fp = dp / fn
            mode = 0o755 if fn.endswith(".so") else 0o644
            os.chmod(fp, mode)


def atomic_write_text(target: Path, content: str) -> None:
    """Atomically write text to target using a temp file in the same directory."""
    target.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp_name = tempfile.mkstemp(prefix=f".{target.name}.", dir=target.parent)
    tmp_path = Path(tmp_name)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(content)
        os.chmod(tmp_path, 0o644)
        os.replace(tmp_path, target)
    except Exception:
        tmp_path.unlink(missing_ok=True)
        raise


def read_hint_file(base_cdm_dir: Path) -> Path | None:
    """Read Path from latest-component-updated-widevine-cdm if present and valid."""
    hint_path = base_cdm_dir / "latest-component-updated-widevine-cdm"
    if not hint_path.is_file():
        return None
    try:
        data = json.loads(hint_path.read_text(encoding="utf-8"))
        p = data.get("Path")
        return Path(p) if p else None
    except (OSError, ValueError, TypeError):
        return None


def install_widevine(
    user_data_dir: Path,
    arch: ArchConfig,
    *,
    force: bool = False,
    chrome_widevine: Path | None = None,
) -> tuple[str, Path, Path]:
    """Download/copy Widevine CDM, validate, install atomically, and update hint file."""
    base_cdm_dir = user_data_dir / "WidevineCdm"
    base_cdm_dir.mkdir(parents=True, exist_ok=True)
    hint_file = base_cdm_dir / "latest-component-updated-widevine-cdm"

    prod_version = detect_prod_version(user_data_dir)
    print(f"Helium user data dir: {user_data_dir}")
    print(f"Detected Chromium prodversion: {prod_version}")

    staging_dir = Path(tempfile.mkdtemp(prefix=".staging-", dir=base_cdm_dir))
    try:
        if chrome_widevine is not None:
            resolved_src = resolve_local_widevine_dir(chrome_widevine)
            print(f"Copying Widevine CDM from {resolved_src} ...")
            for item in resolved_src.iterdir():
                dst = staging_dir / item.name
                if item.is_dir():
                    shutil.copytree(item, dst, dirs_exist_ok=True)
                else:
                    shutil.copy2(item, dst)
        else:
            try:
                fetch_via_omaha(prod_version, staging_dir, arch)
            except Exception as exc:
                print(f"Primary Omaha CRX3 fetch failed ({exc}); trying Chrome .deb fallback ...")
                for child in list(staging_dir.iterdir()):
                    if child.is_dir():
                        shutil.rmtree(child)
                    else:
                        child.unlink()
                fetch_via_chrome_deb(staging_dir, arch)

        version, _ = validate_cdm_dir(staging_dir, arch.subpkg)
        version_dir = base_cdm_dir / version

        current_hint = read_hint_file(base_cdm_dir)
        if not force and current_hint == version_dir and version_dir.is_dir():
            try:
                installed_ver, installed_so = validate_cdm_dir(version_dir, arch.subpkg)
                if installed_ver == version:
                    print(f"Widevine CDM {version} is already installed at {version_dir}")
                    return version, version_dir, installed_so
            except RuntimeError:
                pass

        set_cdm_permissions(staging_dir)
        if version_dir.exists():
            shutil.rmtree(version_dir)
        os.replace(staging_dir, version_dir)
    except Exception:
        if staging_dir.exists():
            shutil.rmtree(staging_dir, ignore_errors=True)
        raise

    _, final_so = validate_cdm_dir(version_dir, arch.subpkg)
    hint_payload = json.dumps({"Path": str(version_dir)}, separators=(",", ":"))
    atomic_write_text(hint_file, hint_payload)

    for entry in base_cdm_dir.iterdir():
        if entry == version_dir or entry == hint_file:
            continue
        if entry.is_dir():
            shutil.rmtree(entry, ignore_errors=True)

    print(f"Installed Widevine CDM {version} -> {version_dir}")
    print(f"Wrote hint file -> {hint_file}")
    return version, version_dir, final_so


def check_ldd(so_path: Path) -> None:
    """Verify libwidevinecdm.so has no missing shared library dependencies."""
    proc = subprocess.run(
        ["ldd", str(so_path)],
        capture_output=True,
        text=True,
        check=True,
    )
    missing = [line.strip() for line in proc.stdout.splitlines() if "not found" in line]
    if missing:
        raise RuntimeError(
            f"Missing shared library dependencies for {so_path}: {'; '.join(missing)}"
        )
    print(f"ldd check passed for {so_path} (no missing dependencies)")


class _ProbeHandler(http.server.BaseHTTPRequestHandler):
    def do_GET(self) -> None:  # noqa: N802
        body = PROBE_HTML.encode("utf-8")
        self.send_response(200)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def log_message(self, format: str, *args: Any) -> None:
        return


def verify_helium_eme(
    user_data_dir: Path,
    arch: ArchConfig,
    helium_binary: Path | None = None,
) -> dict[str, Any]:
    """Verify hint file, ldd, and headless Helium EME com.widevine.alpha support."""
    base_cdm_dir = user_data_dir / "WidevineCdm"
    hint_file = base_cdm_dir / "latest-component-updated-widevine-cdm"
    hinted_path = read_hint_file(base_cdm_dir)
    if hinted_path is None or not hinted_path.is_dir():
        raise RuntimeError(f"Invalid or missing hint target in {hint_file}")

    version, so_path = validate_cdm_dir(hinted_path, arch.subpkg)
    print(f"Verified Widevine directory: {hinted_path} (version {version})")
    check_ldd(so_path)

    resolved_helium = find_helium_binary(helium_binary)

    server = http.server.ThreadingHTTPServer(("127.0.0.1", 0), _ProbeHandler)
    port = server.server_address[1]
    thread = threading.Thread(target=server.serve_forever, daemon=True)
    thread.start()

    tmp_profile = Path(tempfile.mkdtemp(prefix="helium-drm-verify-"))
    try:
        tmp_cdm_dir = tmp_profile / "WidevineCdm"
        tmp_cdm_dir.mkdir(parents=True, exist_ok=True)
        shutil.copy2(hint_file, tmp_cdm_dir / "latest-component-updated-widevine-cdm")

        cmd = [
            str(resolved_helium),
            "--headless=new",
            "--no-first-run",
            "--no-default-browser-check",
            f"--user-data-dir={tmp_profile}",
            "--virtual-time-budget=8000",
            "--dump-dom",
            f"http://127.0.0.1:{port}/",
        ]
        proc = subprocess.run(
            cmd,
            capture_output=True,
            text=True,
            timeout=20,
        )
        match = re.search(
            r'<pre id="eme-result"[^>]*>(.*?)</pre>',
            proc.stdout,
            flags=re.DOTALL,
        )
        if not match:
            raise RuntimeError(
                "Helium headless EME probe produced no #eme-result output.\n"
                f"returncode={proc.returncode}\nstderr:\n{proc.stderr[:2000]}"
            )
        raw_json = html.unescape(match.group(1)).strip()
        if not raw_json:
            raise RuntimeError(
                "Helium headless EME probe #eme-result was empty.\n"
                f"returncode={proc.returncode}\nstderr:\n{proc.stderr[:2000]}"
            )
        results: dict[str, Any] = json.loads(raw_json)
        print("Headless Helium EME com.widevine.alpha probe results:")
        any_ok = False
        for codec, info in results.items():
            if info.get("ok"):
                any_ok = True
                print(f"  - {codec}: SUPPORTED ({info.get('keySystem')})")
            else:
                print(f"  - {codec}: unsupported ({info.get('error')})")

        if not any_ok:
            raise RuntimeError(
                "All com.widevine.alpha EME probes failed in headless Helium.\n"
                f"stderr:\n{proc.stderr[:2000]}"
            )
        return results
    finally:
        server.shutdown()
        server.server_close()
        shutil.rmtree(tmp_profile, ignore_errors=True)


def parse_args(argv: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Patch Helium Browser on Linux with Widevine CDM DRM support."
    )
    parser.add_argument(
        "--verify",
        action="store_true",
        help="Run end-to-end verification against headless Helium after installing.",
    )
    parser.add_argument(
        "--verify-only",
        action="store_true",
        help="Only run verification on the currently installed Widevine CDM.",
    )
    parser.add_argument(
        "--force",
        action="store_true",
        help="Re-download and reinstall even if the same Widevine version is installed.",
    )
    parser.add_argument(
        "--chrome-widevine",
        type=Path,
        default=None,
        help="Optional path to an existing local WidevineCdm directory to copy from.",
    )
    parser.add_argument(
        "--user-data-dir",
        type=Path,
        default=default_user_data_dir(),
        help="Helium user data directory (default: ~/.config/net.imput.helium).",
    )
    parser.add_argument(
        "--helium-binary",
        type=Path,
        default=None,
        help="Path to the Helium browser executable used for --verify.",
    )
    return parser.parse_args(argv)


def main(argv: list[str] | None = None) -> int:
    args = parse_args(sys.argv[1:] if argv is None else argv)
    arch = detect_arch()
    user_data_dir = args.user_data_dir.expanduser().resolve()

    if not args.verify_only:
        install_widevine(
            user_data_dir,
            arch,
            force=args.force,
            chrome_widevine=(
                args.chrome_widevine.expanduser().resolve()
                if args.chrome_widevine
                else None
            ),
        )

    if args.verify or args.verify_only:
        verify_helium_eme(user_data_dir, arch, helium_binary=args.helium_binary)

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
